


### Variables
@baseUrl = http://localhost:8080
@youtubeUrl = https://www.youtube.com/watch?v=dQw4w9WgXcQ

###############################################################################
# PREREQUISITES: Create Parent Case & Milestone
###############################################################################

### 1. Create a Case
# @name createCase
POST {{baseUrl}}/api/v1/cases
Content-Type: application/json

{
  "title": "Chris Watts Investigation Timeline",
  "description": "Chronological timeline of events, news broadcasts, and law enforcement updates regarding the Watts case."
}

### Store Case ID from response
@caseId = {{createCase.response.body.id}}


### 2. Create a Milestone under the Case
# @name createMilestone
POST {{baseUrl}}/api/v1/cases/{{caseId}}/milestones
Content-Type: application/json

{
  "title": "Initial Missing Persons Report & First Media Briefing",
  "event_date": "2018-08-13T12:00:00Z",
  "description": "Local law enforcement and news channels cover the initial disappearance report."
}

### Store Milestone ID from response
@milestoneId = {{createMilestone.response.body.id}}


###############################################################################
# INGESTION & ENRICHMENT PIPELINE
###############################################################################

### 3. Step 1: Ingest Video via YouTube URL
# @name createVideo
POST {{baseUrl}}/api/v1/videos
Content-Type: application/json

{
  "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
  "milestone_id": "{{milestoneId}}"
}

### Store Video ID from response
@videoId = {{createVideo.response.body.id}}


### 4. Duplicate Ingestion Test (409 Conflict)
# Re-submitting the same YouTube video ID should trigger your pgx 23505 conflict handler.
POST {{baseUrl}}/api/v1/videos
Content-Type: application/json

{
  "url": "{{youtubeUrl}}",
  "milestone_id": "{{milestoneId}}"
}


### 5. Fetch Raw Video Before Enrichment (GET /api/v1/videos/{video_id})
# Confirm status is 'pending_review' and ai_summary is null
GET {{baseUrl}}/api/v1/videos/{{videoId}}


### 6. Step 2: Trigger AI Enrichment (POST /api/v1/videos/{video_id}/enrich)
# OpenRouter runs metadata/transcript extraction.
# Status should transition from 'pending_review' -> 'analyzed'.
# @name enrichVideo
POST {{baseUrl}}/api/v1/videos/{{videoId}}/enrich
Content-Type: application/json


### 7. Fetch Enriched Video Details
# Verify category, ai_summary, estimated_event_date, and summary_source
GET {{baseUrl}}/api/v1/videos/{{videoId}}


### 8. List Approved Milestone Videos
# Verify video appears under the milestone timeline
GET {{baseUrl}}/api/v1/milestones/{{milestoneId}}/videos