# in case of db destruction, create testing data.   -    ALSO NEED TO MAKE A FILE THAT TESTS ALL ENDPONT FUNCTIONS

# creates a case
# with 5 milestones
# with 5 videos per milestone
# all videos marked as approved for now

### Variables
@host = http://localhost:8080
@email = testuser@example.com
@password = Password123!

@case1 = 'The Chris Watts Case'
@description1 = 'Family Annihilator'

@milestone1 = 'Day of Incident'
@milestone2 = 'Family Missing'
@milestone3 = 'Porch Interview'
@milestone4 = 'Interrogation and Confession'
@milestone5 = 'Court Proceedings'

